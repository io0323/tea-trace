<% content_for :title, "新規出荷情報" %>

<div class="min-h-screen bg-gray-50">
  <%= render "shared/navigation" %>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Page Header -->
    <div class="mb-8">
      <nav class="flex mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-4">
          <li>
            <%= link_to "ホーム", root_path, class: "text-gray-500 hover:text-gray-700" %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="flex-shrink-0 h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
              <%= link_to "ロット詳細", tea_lot_path(@tea_lot), class: "ml-4 text-gray-500 hover:text-gray-700" %>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="flex-shrink-0 h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
              <%= link_to "出荷情報一覧", tea_lot_shipments_path(@tea_lot), class: "ml-4 text-gray-500 hover:text-gray-700" %>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="flex-shrink-0 h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="ml-4 text-gray-500">新規出荷情報</span>
            </div>
          </li>
        </ol>
      </nav>

      <div class="flex justify-between items-start">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">新規出荷情報</h1>
          <p class="mt-2 text-gray-600">ロット: <%= @tea_lot.lot_code %></p>
        </div>
      </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
      <div class="bg-gradient-to-r from-green-500 to-green-600 px-6 py-4">
        <h2 class="text-xl font-semibold text-white">出荷情報を登録</h2>
      </div>
      
      <div class="p-6">
        <%= form_with(model: [@tea_lot, @shipment], local: true, class: "space-y-6") do |form| %>
          <% if @shipment.errors.any? %>
            <div class="rounded-md bg-red-50 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-red-800">
                    <%= pluralize(@shipment.errors.count, "error") %> prohibited this shipment from being saved:
                  </h3>
                  <div class="mt-2 text-sm text-red-700">
                    <ul class="list-disc list-inside space-y-1">
                      <% @shipment.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="col-span-2">
              <%= form.label :destination, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_field :destination, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
            </div>

            <div>
              <%= form.label :shipped_at, class: "block text-sm font-medium text-gray-700" %>
              <%= form.date_field :shipped_at, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
            </div>

            <div>
              <%= form.label :quantity_kg, class: "block text-sm font-medium text-gray-700" %>
              <%= form.number_field :quantity_kg, step: "0.1", min: "0.1", class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
              <p class="mt-1 text-sm text-gray-500">単位: kg</p>
            </div>

            <div class="col-span-2">
              <%= form.label :notes, class: "block text-sm font-medium text-gray-700" %>
              <%= form.text_area :notes, rows: 4, class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
            </div>
          </div>

          <!-- Tea Lot Info -->
          <div class="bg-gray-50 p-4 rounded-md">
            <h3 class="text-sm font-medium text-gray-700 mb-2">関連ロット情報</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
              <div>
                <span class="text-gray-500">ロットコード:</span>
                <span class="ml-1 text-gray-900"><%= @tea_lot.lot_code %></span>
              </div>
              <div>
                <span class="text-gray-500">産地:</span>
                <span class="ml-1 text-gray-900"><%= @tea_lot.origin %></span>
              </div>
              <div>
                <span class="text-gray-500">品種:</span>
                <span class="ml-1 text-gray-900"><%= @tea_lot.variety %></span>
              </div>
              <div>
                <span class="text-gray-500">在庫:</span>
                <span class="ml-1 text-gray-900"><%= @tea_lot.formatted_quantity %> kg</span>
              </div>
            </div>
          </div>

          <div class="flex justify-end space-x-3">
            <%= link_to "キャンセル", tea_lot_shipments_path(@tea_lot), 
                class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
            <%= form.submit "登録", class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
