<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
      <div class="mt-3">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-semibold text-gray-900">工程イベントを追加</h3>
          <%= link_to "×", tea_lot_path(@tea_lot), 
              class: "text-gray-400 hover:text-gray-600 text-2xl font-bold",
              data: { turbo_frame: "modal" } %>
        </div>
        
        <%= form_with model: [@tea_lot, @process_event], 
            data: { turbo: true }, 
            class: "space-y-4" do |form| %>
          
          <% if @process_event.errors.any? %>
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
              <ul class="list-disc list-inside">
                <% @process_event.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          
          <div>
            <%= form.label :event_type, "工程種別", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.select :event_type, 
                options_for_select([
                  ['蒸し', 'steaming'],
                  ['揉み', 'rolling'], 
                  ['乾燥', 'drying'],
                  ['包装', 'packing']
                ], @process_event.event_type),
                { prompt: "選択してください" },
                { class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500" } %>
          </div>
          
          <div>
            <%= form.label :occurred_at, "発生日時", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.datetime_local_field :occurred_at,
                class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
          
          <div>
            <%= form.label :note, "備考", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_area :note, rows: 3,
                class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
                placeholder: "任意の備考入力..." %>
          </div>
          
          <div class="flex justify-end space-x-3 pt-4">
            <%= link_to "キャンセル", tea_lot_path(@tea_lot), 
                class: "px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400 transition-colors",
                data: { turbo_frame: "modal" } %>
            <%= form.submit "追加", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
