<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- Breadcrumb -->
  <nav class="flex mb-8" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
      <li class="inline-flex items-center">
        <%= link_to "ロット一覧", tea_lots_path, class: "text-gray-700 hover:text-green-600 inline-flex items-center" %>
      </li>
      <li>
        <div class="flex items-center">
          <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
          <%= link_to @tea_lot.lot_code, tea_lot_path(@tea_lot), class: "text-gray-700 hover:text-green-600 inline-flex items-center" %>
        </div>
      </li>
      <li>
        <div class="flex items-center">
          <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
          <span class="ml-2 text-gray-500 md:ml-3">工程イベント詳細</span>
        </div>
      </li>
    </ol>
  </nav>

  <!-- Page Header -->
  <div class="mb-8">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">工程イベント詳細</h1>
        <p class="mt-2 text-gray-600">ロット: <%= @tea_lot.lot_code %> | <%= @process_event.event_type_label %></p>
      </div>
      <div class="flex items-center space-x-3">
        <%= link_to "編集", edit_tea_lot_process_event_path(@tea_lot, @process_event), class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors inline-flex items-center space-x-2" %>
        <%= link_to "削除", tea_lot_process_event_path(@tea_lot, @process_event), 
            method: :delete,
            class: "px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 transition-colors inline-flex items-center space-x-2" %>
      </div>
    </div>
  </div>

  <!-- Event Information Card -->
  <div class="bg-white shadow rounded-lg overflow-hidden mb-8">
    <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
      <h2 class="text-xl font-semibold text-white">イベント情報</h2>
    </div>
    
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">工程種別</p>
              <p class="text-lg font-semibold text-gray-900"><%= @process_event.event_type_label %></p>
            </div>
          </div>
        </div>
        
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">発生日時</p>
              <p class="text-lg text-gray-900"><%= @process_event.occurred_at.strftime("%Y年%m月%d日 %H:%M") %></p>
            </div>
          </div>
        </div>
      </div>

      <% if @process_event.note.present? %>
        <div class="mt-6">
          <h3 class="text-sm font-medium text-gray-700 mb-2">備考</h3>
          <div class="bg-gray-50 rounded-lg p-4">
            <p class="text-gray-900 whitespace-pre-wrap"><%= @process_event.note %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Timeline Context -->
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-4">
      <h2 class="text-xl font-semibold text-white">タイムライン文脈</h2>
    </div>
    
    <div class="p-6">
      <div class="space-y-4">
        <!-- Previous Events -->
        <% previous_events = @tea_lot.process_events.where("occurred_at < ?", @process_event.occurred_at).order(occurred_at: :desc) %>
        <% if previous_events.any? %>
          <div>
            <h3 class="text-sm font-medium text-gray-700 mb-3">前の工程</h3>
            <div class="space-y-2">
              <% previous_events.limit(3).each do |event| %>
                <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                  <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
                  <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900"><%= event.event_type_label %></p>
                    <p class="text-xs text-gray-500"><%= event.occurred_at.strftime("%Y/%m/%d %H:%M") %></p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Current Event -->
        <div>
          <h3 class="text-sm font-medium text-gray-700 mb-3">現在の工程</h3>
          <div class="flex items-center space-x-3 p-4 bg-blue-50 border-2 border-blue-200 rounded-lg">
            <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
            <div class="flex-1">
              <p class="font-medium text-blue-900"><%= @process_event.event_type_label %></p>
              <p class="text-sm text-blue-700"><%= @process_event.occurred_at.strftime("%Y/%m/%d %H:%M") %></p>
            </div>
          </div>
        </div>

        <!-- Next Events -->
        <% next_events = @tea_lot.process_events.where("occurred_at > ?", @process_event.occurred_at).order(occurred_at: :asc) %>
        <% if next_events.any? %>
          <div>
            <h3 class="text-sm font-medium text-gray-700 mb-3">次の工程</h3>
            <div class="space-y-2">
              <% next_events.limit(3).each do |event| %>
                <div class="flex items-center space-x-3 p-3 bg-gray-50 rounded-lg">
                  <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
                  <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900"><%= event.event_type_label %></p>
                    <p class="text-xs text-gray-500"><%= event.occurred_at.strftime("%Y/%m/%d %H:%M") %></p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Time Differences -->
      <% if previous_events.any? %>
        <div class="mt-6 pt-6 border-t border-gray-200">
          <h3 class="text-sm font-medium text-gray-700 mb-3">時間間隔</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-gray-50 rounded-lg p-3">
              <p class="text-xs text-gray-500">前の工程から</p>
              <p class="text-sm font-medium text-gray-900">
                <%= distance_of_time_in_words(@process_event.occurred_at, previous_events.first.occurred_at) %>
              </p>
            </div>
            <% if next_events.any? %>
              <div class="bg-gray-50 rounded-lg p-3">
                <p class="text-xs text-gray-500">次の工程まで</p>
                <p class="text-sm font-medium text-gray-900">
                  <%= distance_of_time_in_words(next_events.first.occurred_at, @process_event.occurred_at) %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Actions -->
  <div class="mt-8 flex justify-center">
    <%= link_to tea_lot_path(@tea_lot), class: "inline-flex items-center px-6 py-3 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
      <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
      </svg>
      ロット詳細に戻る
    <% end %>
  </div>
</div>
