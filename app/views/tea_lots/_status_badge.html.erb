<% status_class = case tea_lot.status
                 when "received"
                   "bg-blue-100 text-blue-800"
                 when "processing"
                   "bg-yellow-100 text-yellow-800"
                 when "shipped"
                   "bg-green-100 text-green-800"
                 end %>

<% status_text = case tea_lot.status
                 when "received"
                   "受入済"
                 when "processing"
                   "加工中"
                 when "shipped"
                   "出荷済"
                 end %>

<span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full <%= status_class %>">
  <%= status_text %>
</span>
