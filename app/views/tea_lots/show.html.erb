<div class="min-h-screen bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <%= link_to "← ロット一覧に戻る", tea_lots_path, class: "text-blue-600 hover:text-blue-800 transition-colors mb-4 inline-block" %>
      <h1 class="text-3xl font-bold text-gray-900">ロット詳細</h1>
    </div>

    <!-- Lot Information Card -->
    <div class="bg-white shadow rounded-lg p-6 mb-8">
      <div class="border-b border-gray-200 pb-4 mb-4">
        <h2 class="text-xl font-semibold text-gray-900">基本情報</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div>
          <p class="text-sm font-medium text-gray-500">ロットコード</p>
          <p class="text-lg font-semibold text-gray-900"><%= @tea_lot.lot_code %></p>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">産地</p>
          <p class="text-lg text-gray-900"><%= @tea_lot.origin %></p>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">品種</p>
          <p class="text-lg text-gray-900"><%= @tea_lot.variety %></p>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">収穫日</p>
          <p class="text-lg text-gray-900"><%= @tea_lot.harvest_date.strftime("%Y年%m月%d日") %></p>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">数量</p>
          <p class="text-lg text-gray-900"><%= @tea_lot.quantity_kg %> kg</p>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-500">ステータス</p>
          <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full 
            <% case @tea_lot.status %>
            <% when 'received' %>bg-blue-100 text-blue-800
            <% when 'processing' %>bg-yellow-100 text-yellow-800
            <% when 'shipped' %>bg-green-100 text-green-800
            <% end %>">
            <% case @tea_lot.status %>
            <% when 'received' %>受入済
            <% when 'processing' %>加工中
            <% when 'shipped' %>出荷済
            <% end %>
          </span>
        </div>
      </div>
    </div>

    <!-- Process Timeline -->
    <div class="bg-white shadow rounded-lg p-6 mb-8">
      <div class="border-b border-gray-200 pb-4 mb-6 flex justify-between items-center">
        <h2 class="text-xl font-semibold text-gray-900">工程タイムライン</h2>
        <%= link_to "工程を追加", new_tea_lot_process_event_path(@tea_lot), 
            class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors",
            data: { turbo_frame: "modal" } %>
      </div>
      
      <% if @tea_lot.process_events.any? %>
        <div class="relative">
          <!-- Timeline Line -->
          <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gray-300"></div>
          
          <% @tea_lot.process_events.order(:occurred_at).each_with_index do |event, index| %>
            <div class="relative flex items-start mb-8">
              <!-- Timeline Dot -->
              <div class="flex-shrink-0 w-16 h-16 bg-white rounded-full border-4 border-blue-500 flex items-center justify-center z-10">
                <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
              </div>
              
              <!-- Event Content -->
              <div class="ml-6 flex-1">
                <div class="bg-gray-50 rounded-lg p-4">
                  <div class="flex justify-between items-start mb-2">
                    <h3 class="text-lg font-semibold text-gray-900"><%= event.event_type_label %></h3>
                    <span class="text-sm text-gray-500"><%= event.occurred_at.strftime("%Y/%m/%d %H:%M") %></span>
                  </div>
                  <% if event.note.present? %>
                    <p class="text-gray-600"><%= event.note %></p>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-12">
          <p class="text-gray-500">工程イベントが登録されていません。</p>
        </div>
      <% end %>
    </div>

    <!-- Shipment History -->
    <div class="bg-white shadow rounded-lg p-6">
      <div class="border-b border-gray-200 pb-4 mb-4">
        <h2 class="text-xl font-semibold text-gray-900">出荷履歴</h2>
      </div>
      
      <% if @tea_lot.shipments.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  出荷先
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  出荷日
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  数量
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @tea_lot.shipments.each do |shipment| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= shipment.destination %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= shipment.shipped_at.strftime("%Y年%m月%d日") %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= shipment.quantity_kg %> kg
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <p class="text-gray-500">出荷履歴がありません。</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Turbo Frame for Modal -->
<%= turbo_frame_tag "modal" do %>
  <!-- Modal content will be loaded here -->
<% end %>
