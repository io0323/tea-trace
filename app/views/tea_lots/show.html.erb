<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- Breadcrumb -->
  <nav class="flex mb-8" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
      <li class="inline-flex items-center">
        <%= link_to "ロット一覧", tea_lots_path, class: "text-gray-700 hover:text-green-600 inline-flex items-center" %>
      </li>
      <li>
        <div class="flex items-center">
          <svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
          <span class="ml-2 text-gray-500 md:ml-3"><%= @tea_lot.lot_code %></span>
        </div>
      </li>
    </ol>
  </nav>

  <!-- Page Header -->
  <div class="mb-8">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">ロット詳細</h1>
        <p class="mt-2 text-gray-600">ロットコード: <%= @tea_lot.lot_code %></p>
      </div>
      <div class="flex items-center space-x-3">
        <%= render "status_badge", tea_lot: @tea_lot %>
        <button class="p-2 text-gray-400 hover:text-gray-600 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Lot Information Card -->
  <div class="bg-white shadow rounded-lg overflow-hidden mb-8">
    <div class="bg-gradient-to-r from-green-500 to-green-600 px-6 py-4">
      <h2 class="text-xl font-semibold text-white">基本情報</h2>
    </div>
    
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">ロットコード</p>
              <p class="text-lg font-semibold text-gray-900"><%= @tea_lot.lot_code %></p>
            </div>
          </div>
        </div>
        
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">産地</p>
              <p class="text-lg text-gray-900"><%= @tea_lot.origin %></p>
            </div>
          </div>
        </div>
        
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">品種</p>
              <p class="text-lg text-gray-900"><%= @tea_lot.variety %></p>
            </div>
          </div>
        </div>
        
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-yellow-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">収穫日</p>
              <p class="text-lg text-gray-900"><%= @tea_lot.harvest_date.strftime("%Y年%m月%d日") %></p>
            </div>
          </div>
        </div>
        
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-indigo-600" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">数量</p>
              <p class="text-lg text-gray-900"><%= @tea_lot.formatted_quantity %> kg</p>
            </div>
          </div>
        </div>
        
        <div class="bg-gray-50 rounded-lg p-4">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-500">ステータス</p>
              <div class="mt-1"><%= render "status_badge", tea_lot: @tea_lot %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Process Timeline -->
  <div class="bg-white shadow rounded-lg overflow-hidden mb-8">
    <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
      <div class="flex justify-between items-center">
        <h2 class="text-xl font-semibold text-white">工程タイムライン</h2>
        <%= link_to "工程を追加", new_tea_lot_process_event_path(@tea_lot), 
            class: "px-4 py-2 bg-white text-blue-600 rounded-md hover:bg-gray-100 transition-colors" %>
      </div>
    </div>
    
    <div class="p-6">
      <% if @tea_lot.process_events.any? %>
        <div class="relative">
          <!-- Timeline Line -->
          <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-200 to-blue-300"></div>
          
          <% @tea_lot.process_events.order(:occurred_at).each_with_index do |event, index| %>
            <div class="relative flex items-start mb-8">
              <!-- Timeline Dot -->
              <div class="flex-shrink-0 w-16 h-16 bg-white rounded-full border-4 border-blue-500 flex items-center justify-center z-10 shadow-lg">
                <div class="w-3 h-3 bg-blue-500 rounded-full"></div>
              </div>
              
              <!-- Event Content -->
              <div class="ml-6 flex-1">
                <div class="bg-gradient-to-r from-gray-50 to-gray-100 rounded-lg p-4 shadow-sm hover:shadow-md transition-shadow">
                  <div class="flex justify-between items-start mb-2">
                    <h3 class="text-lg font-semibold text-gray-900"><%= event.event_type_label %></h3>
                    <span class="text-sm text-gray-500 bg-white px-2 py-1 rounded-full"><%= event.occurred_at.strftime("%Y/%m/%d %H:%M") %></span>
                  </div>
                  <% if event.note.present? %>
                    <p class="text-gray-600"><%= event.note %></p>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">工程イベントがありません</h3>
          <p class="mt-1 text-sm text-gray-500">このロットの加工工程を記録しましょう。</p>
          <div class="mt-6">
            <%= link_to "最初の工程を追加", new_tea_lot_process_event_path(@tea_lot), 
                class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Shipment History -->
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-4">
      <h2 class="text-xl font-semibold text-white">出荷履歴</h2>
    </div>
    
    <div class="p-6">
      <% if @tea_lot.shipments.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  出荷先
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  出荷日
                </th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  数量
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @tea_lot.shipments.each do |shipment| %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                    <%= shipment.destination %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= shipment.shipped_at.strftime("%Y年%m月%d日") %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <%= shipment.formatted_quantity %> kg
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">出荷履歴がありません</h3>
          <p class="mt-1 text-sm text-gray-500">このロットはまだ出荷されていません。</p>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Turbo Frame for Modal -->
<%= turbo_frame_tag "modal" do %>
  <!-- Modal content will be loaded here -->
<% end %>
